@page
@using DataBaseModel
@{
    Layout = null;
    var SystemConfig = Config.SystemConfig();
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        @@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@200;300;400;500;600;700;800&display=swap");
    </style>
    <script>
        localStorage.setItem("TITULO", '@SystemConfig.TITULO');
        localStorage.setItem("SUB_TITULO", '@SystemConfig.SUB_TITULO');
        localStorage.setItem("NOMBRE_EMPRESA", '@SystemConfig.NOMBRE_EMPRESA');
        localStorage.setItem("MEDIA_IMG_PATH", '@SystemConfig.MEDIA_IMG_PATH');
        localStorage.setItem("MEDIA_ATTACH_PATH", '@SystemConfig.MEDIA_ATTACH_PATH');
        localStorage.setItem("LOGO_PRINCIPAL", '@SystemConfig.LOGO_PRINCIPAL');
        localStorage.setItem("MEMBRETE_HEADER", '@SystemConfig.MEMBRETE_HEADER');
        localStorage.setItem("MEMBRETE_FOOTHER", '@SystemConfig.MEMBRETE_FOOTHER');
        sessionStorage.setItem("USE_ONLY_FILE_NAME", localStorage.getItem("MEDIA_ATTACH_PATH") == "");
    </script>
    <script src="~/WDevCore/Security/Login.js" type="module"></script>
    <link rel="stylesheet" href="/WDevCore/Security/Styles/style.css" />
</head>


<body id="App">
    <div class="container">        
        <div class="forms-container">
            <div class="signin-signup" id="container"></div>
        </div>
        <div class="panels-container">
            <div class="panel left-panel">
                <div class="content">
                    <img class="logo" src="/Media/img/logo.png"/>
                    <h3>@SystemConfig.TITULO</h3>
                    <p>@SystemConfig.SUB_TITULO</p>
                </div>
                <img src="/WDevCore/Security/Styles/img/log.svg" class="image" alt="" />
            </div>
            <div class="panel right-panel">
                <div class="content">
                    <h3>One of us ?</h3>
                    <p>
                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Nostrum
                        laboriosam ad deleniti.
                    </p>
                    <button class="btn transparent" id="sign-in-btn">
                        Sign in
                    </button>
                </div>
                <img src="/WDevCore/Security/Styles/img/register.svg" class="image" alt="" />
            </div>
        </div>
    </div>
</body>

</html>